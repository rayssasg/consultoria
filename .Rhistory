library(bookdown)
install.packages("bookdown")
install.packages("bookdown")
library(bookdown)
knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(ggplot2)
zero_tres_anos <- read_csv("C:/Users/biaai/Downloads/0-3 - 0-3.csv")
ada <- read_csv("C:/Users/biaai/Downloads/ada - ada.csv")
ada <- ada %>% rename("Competência" = "Comp.")
dados <- full_join(zero_tres_anos, ada)
# Apenas crianças/adolescentes
dados <- dados %>%
filter(Idade <= 18)
n_criancas <- n_distinct(dados$`Nome Beneficiário`)
n_cartoes  <- n_distinct(dados$`Nº Cartão`)
cat("Procedimentos totais:", nrow(dados), "\n")
cat("Crianças distintas:", n_criancas, "\n")
cat("Cartões distintos:", n_cartoes, "\n\n")
idades <- dados %>%
group_by(`Nome Beneficiário`) %>%
summarise(idade_primeira = min(Idade, na.rm = TRUE),
idade_final   = max(Idade, na.rm = TRUE))
summary(idades)
View(idades)
idades %>%
ggplot(aes(x = idade_final)) +
geom_histogram(binwidth = 1, fill = "steelblue", color = "white") +
labs(title = "Distribuição de idade",
x = "Idade (anos)", y = "Frequência")
dados <- dados %>%
mutate(
duracao_min = case_when(
`Duração por sessão` == "30 a 40 minutos" ~ 35,
`Duração por sessão` == "50 minutos" ~ 50,
TRUE ~ NA_real_
),
horas = (duracao_min * `Qtde (Itens)`)/60
)
View(dados)
proc_por_crianca <- dados %>%
group_by(`Nome Beneficiário`) %>%
summarise(n_procedimentos = n(),
total_horas     = sum(horas, na.rm = TRUE))
summary(proc_por_crianca)
View(proc_por_crianca)
summary(horas)
summary(dados$horas)
View(idades)
horas_por_idade <- dados %>%
group_by(`Nome Beneficiário`, Idade) %>%
summarise(horas_total = sum(horas, na.rm = TRUE),
n_procs     = n(),
.groups = "drop")
# Identificar extremos por criança
horas_extremos <- horas_por_idade %>%
group_by(`Nome Beneficiário`) %>%
summarise(
idade_primeira = min(Idade, na.rm = TRUE),
horas_primeira = horas_total[which.min(Idade)],
idade_recente  = max(Idade, na.rm = TRUE),
horas_recente  = horas_total[which.max(Idade)],
.groups = "drop"
) %>%
mutate(dif_horas = horas_recente - horas_primeira) %>% filter(dif_horas != 0)
head(horas_extremos)
View(horas_extremos)
View(horas_por_idade)
View(horas_por_idade)
horas_por_idade %>%
ggplot(aes(x=Idade, y= horas_total)) +
geom_point(alpha = 0.6, color = "steelblue") +
geom_smooth(method = "lm", se = TRUE, color = "darkred") +
labs(title = "Idade x Horas totais de atendimento (por criança)",
x = "Idade (anos)",
y = "Horas totais de atendimento") +
theme_minimal()
cor.test(horas_por_idade$Idade, horas_por_idade$horas_total, method = "pearson")
cor.test(horas_por_idade$Idade, horas_por_idade$horas_total, method = "spearman")
cor.test(horas_por_idade$Idade, horas_por_idade$horas_total, method = "pearson")
# Distribuição de idades
dados %>%
ggplot(aes(x = Idade)) +
geom_histogram(binwidth = 1, fill = "steelblue", color = "white") +
labs(title = "Distribuição de atendimentos por idade",
x = "Idade (anos)", y = "Nº procedimentos")
# Evolução da média de horas por idade
horas_por_idade %>%
group_by(Idade) %>%
summarise(media_horas = mean(horas_total, na.rm = TRUE)) %>%
ggplot(aes(x = Idade, y = media_horas)) +
geom_line(color = "darkred", size = 1.2) +
geom_point(color = "darkred") +
labs(title = "Evolução da média de horas de atendimento por idade",
x = "Idade (anos)", y = "Média de horas")
# Diferença de carga de atendimento (primeira vs última idade)
horas_extremos %>% filter(dif_horas != 0) %>%
ggplot(aes(x = dif_horas)) +
geom_histogram(binwidth = 1, fill = "darkgreen", color = "white") +
labs(title = "Diferença de horas entre primeira e última idade",
x = "Horas (positivas = mais velho demandou mais)", y = "Nº crianças")
