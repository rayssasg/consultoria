dados <- dados %>%
mutate(
# Categorizar IMC
bmi_cat = ifelse(imc < 25, "1Normal", "2Elevado"),
# Categorizar idade
idade_cat = case_when(
idade < 40 ~ "Jovem",
idade < 60 ~ "Adulto",
TRUE ~ "Idoso"
),
# Categorizar glicose
glicose_cat = ifelse(glicose_media < 100, "1Normal", "Elevado"),
# Categorizar fumante
fumante = case_when(
status_fumante == "Nunca fumou" ~ "1Nunca fumou",
status_fumante %in% c("Fuma", "Fumou anteriormente") ~ "2Já fumou",
TRUE ~ "Desconhecido"
)
)
ggplot(dados, aes(x = bmi_cat, fill = avc)) +
geom_bar(position = "dodge") +
labs(title = "AVC por Categoria de IMC", x = "Categoria de IMC", y = "Contagem", fill = "AVC") +
theme_minimal(base_size = 14)
